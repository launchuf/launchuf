# Kopiera till .env för lokal utveckling. Committa ALDRIG .env (den är gitignorerad).
# I produktion sätts allt i Cloudflare (se README) — inte i GitHub.

# ---- Bygg-variabler (Cloudflare: Settings → Build → Variables) — publika värden ----
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_eller_anon_key
VITE_SITE_URL=https://dindomän.se
# Valfritt: Cloudflare Turnstile (spamskydd) — publik sitekey
VITE_TURNSTILE_SITE_KEY=

# ---- Runtime (Cloudflare: Settings → Variables and Secrets) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_eller_anon_key
PUBLIC_SITE_URL=https://dindomän.se

# ---- Endast hemligheter (typ "Secret" i Cloudflare) ----
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TURNSTILE_SECRET_KEY=
